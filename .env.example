# Granger Bank — environment variable names only. NEVER put real values in
# this file; it is committed to version control. Real values live in
# .env.local (gitignored) for development, and in the secret manager for
# staging/production. See docs/production/06-banking-provider-integration.md §5.

# --- Core infrastructure --------------------------------------------------
DATABASE_URL=
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Session / CSRF secrets ------------------------------------------------
# Generate with: openssl rand -base64 48
SESSION_COOKIE_SECRET=
CSRF_SECRET=

# --- Field-level encryption -------------------------------------------------
# 32-byte key, base64-encoded, for AES-256-GCM envelope encryption of
# sensitive fields (tax id, beneficiary account numbers, MFA secrets).
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# --- Email delivery ---------------------------------------------------------
# Absent in development (falls back to ConsoleEmailProvider, which logs
# instead of sending). Required in production or the app fails closed on
# verification/reset emails.
EMAIL_PROVIDER_API_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Banking / payment provider (Phase 10 — do not set until a real,
# authorized provider is under contract; see
# docs/production/09-client-requirements-and-credentials.md) -----------------
BANKING_API_URL=
BANKING_API_KEY=
BANKING_CLIENT_ID=
BANKING_CLIENT_SECRET=
BANKING_WEBHOOK_SIGNING_SECRET=

PAYMENT_API_URL=
PAYMENT_API_KEY=

CARD_PROVIDER_API_URL=
CARD_PROVIDER_API_KEY=

KYC_PROVIDER_API_URL=
KYC_PROVIDER_API_KEY=

FRAUD_PROVIDER_API_URL=
FRAUD_PROVIDER_API_KEY=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info
